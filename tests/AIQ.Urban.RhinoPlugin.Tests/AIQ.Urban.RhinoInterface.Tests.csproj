<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 8 Windows: net48, net7.0-windows, net7.0-windows10.0.22000.0, etc
    -->
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
	  <LangVersion>12</LangVersion>
  </PropertyGroup>
  
  <PropertyGroup>
    <Version>1.0</Version>
    <Title>AIQ.Urban.RhinoPlugin.Tests</Title>
    <Company>AIQ.Urban.RhinoPlugin.Tests Authors</Company>
    <Description>Description of AIQ.Urban.RhinoPlugin.Tests</Description>

    <NoWarn>NU1701;MSB3277</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="Rhino.Testing" Version="8.0.28-beta" />

    <PackageReference Include="RhinoCommon" Version="8.32.26131.18001-rc" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\src\AIQ.Exports\AIQ.Exports.csproj" />
    <ProjectReference Include="..\..\src\AIQ.Urban.RhinoInterface\AIQ.Urban.RhinoInterface.csproj" />
    <ProjectReference Include="..\..\src\AIQ.Urban.Rhino\AIQ.Urban.RhinoPlugin.csproj">
      <!--
        Loading the .rhp as a test runtime asset aborts testhost while CoreCLR starts.
        Keep it out of the dependency graph; CopyRhinoPluginAsTestAssembly supplies
        the same managed assembly with the .dll extension expected by testhost.
      -->
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\tools\AIQ.Urban.DebugViz\AIQ.Urban.DebugViz.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Rhino.Testing.Configs.xml" CopyToOutputDirectory="always" />
  </ItemGroup>

  <Target Name="CopyRhinoPluginAsTestAssembly"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <_RhinoPluginReference Include="@(_ResolvedProjectReferencePaths)"
                             Condition="'%(Filename)' == 'AIQ.Urban.RhinoPlugin'" />
    </ItemGroup>

    <Delete Files="$(TargetDir)AIQ.Urban.RhinoPlugin.rhp" />
    <Copy SourceFiles="@(_RhinoPluginReference)"
          DestinationFiles="@(_RhinoPluginReference->'$(TargetDir)%(Filename).dll')" />
  </Target>

</Project>
