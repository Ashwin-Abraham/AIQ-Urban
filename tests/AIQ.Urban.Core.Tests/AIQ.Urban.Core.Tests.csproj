    <LangVersion>12</LangVersion>
  </PropertyGroup>
  
  <PropertyGroup>
    <Version>1.0</Version>
    <Title>AIQ.Urban.Core.Tests</Title>
    <Company>AIQ.Urban.Core.Tests Authors</Company>
    <Description>Description of AIQ.Urban.Core.Tests</Description>
