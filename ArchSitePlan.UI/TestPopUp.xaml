<Window x:Class="ArchSitePlan.UI.TestPopUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArchSitePlan.UI"
        mc:Ignorable="d"
        Title="TestPopUp" 
        WindowStyle="None"
        AllowsTransparency="True"
        Opacity="0.8"
        Height="120"
        Width="250"
        Topmost="True"
        >
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Title"
                   Text="Selected Road Details"
                   Grid.ColumnSpan="4"
                   HorizontalAlignment="Center"
                   FontSize="16"/>

        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="("/>
            <TextBlock x:Name="SelectionCount"
                   Text="23"
                       FontStyle="Italic"/>
            <TextBlock Text="selected"
                   Margin="5,0,0,0"
                       FontStyle="Italic"/>
            <TextBlock Text=")"/>
        </StackPanel>


        <!--Item 1-->
        <TextBlock x:Name="DataTitle1"
                   Text="Width"
                   Grid.Row="2"
                   Grid.Column="0"
                   VerticalAlignment="Center" />

        <TextBlock x:Name="DataContent1"
                   Text="5m"
                   Grid.Row="2"
                   Grid.Column="1"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />

        <!--Item 2-->
        <TextBlock x:Name="DataTitle2"
           Text="Length"
           Grid.Row="3"
           Grid.Column="0"
           VerticalAlignment="Center" />

        <TextBlock x:Name="DataContent2"
           Text="x m"
           Grid.Row="3"
           Grid.Column="1"
           FontWeight="Bold"
           VerticalAlignment="Center" />

        <!--Item 3-->
        <TextBlock x:Name="DataTitle3"
           Text="Area"
           Grid.Row="4"
           Grid.Column="0"
           VerticalAlignment="Center" />

        <TextBlock x:Name="DataContent3"
           Text="x sqm"
           Grid.Row="4"
           Grid.Column="1"
           FontWeight="Bold"
           VerticalAlignment="Center" />    

        <!--Item 4-->
        <TextBlock x:Name="DataTitle4"
           Text="Other Prop"
           Grid.Row="2"
           Grid.Column="2"
           VerticalAlignment="Center" />    

        <TextBlock x:Name="DataContent4"
           Text="?? units"
           Grid.Row="2"
           Grid.Column="3"
           FontWeight="Bold"
           VerticalAlignment="Center" />

        <!--Item 5-->
        <TextBlock x:Name="DataTitle5"
           Text="Other Prop"
           Grid.Row="3"
           Grid.Column="2"
           VerticalAlignment="Center" />

        <TextBlock x:Name="DataContent5"
           Text="?? units"
           Grid.Row="3"
           Grid.Column="3"
           FontWeight="Bold"
           VerticalAlignment="Center" />

        <!--Item 6-->
        <TextBlock x:Name="DataTitle6"
           Text="Other Prop"
           Grid.Row="4"
           Grid.Column="2"
           VerticalAlignment="Center" />

        <TextBlock x:Name="DataContent6"
           Text="?? units"
           Grid.Row="4"
           Grid.Column="3"
           FontWeight="Bold"
           VerticalAlignment="Center" />
    </Grid>
</Window>
