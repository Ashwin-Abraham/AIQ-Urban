<UserControl x:Class="ArchSitePlan.UI.UserControls.MetricBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArchSitePlan.UI.UserControls"
             mc:Ignorable="d" 
             Width="60"
             Height="60"
             d:Background="White"
             Margin="2">
    <Grid Background="LightGray"
          DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Value, FallbackValue=x, Mode=TwoWay}"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"/>

        <TextBlock Text="{Binding Unit, FallbackValue=units, Mode=TwoWay}"
                   Grid.Column="1"
                   FontSize="8"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="2,0,0,1.2"/>

        <TextBlock Text="{Binding MetricName, FallbackValue=metric, Mode=TwoWay}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Grid.ColumnSpan="2"
                   FontSize="8"
                   TextWrapping="Wrap"
                   Grid.Row="1"/>
    </Grid>
</UserControl>
