<UserControl x:Class="ArchSitePlan.UI.UserControls.HorizontalGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArchSitePlan.UI.UserControls"
             FontSize="8"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="200" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding GraphTitle, FallbackValue=Title}" 
                   Grid.ColumnSpan="4" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!--Graph Bars-->
        <Rectangle Grid.Column="1" 
                   Grid.Row="1"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[0].Color, FallbackValue=Brown}"
                   Width="{Binding GraphData[0].BarHeight, FallbackValue=25}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="2"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[1].Color, FallbackValue=Blue}"
                   Width="{Binding GraphData[1].BarHeight, FallbackValue=25}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="3"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[2].Color, FallbackValue=Red}"
                   Width="{Binding GraphData[2].BarHeight, FallbackValue=25}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="4"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[3].Color, FallbackValue=Green}"
                   Width="{Binding GraphData[3].BarHeight, FallbackValue=10}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="5"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[4].Color, FallbackValue=Orange}"
                   Width="{Binding GraphData[4].BarHeight, FallbackValue=10}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="6"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[5].Color, FallbackValue=Brown}"
                   Width="{Binding GraphData[5].BarHeight, FallbackValue=25}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="7"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[6].Color, FallbackValue=Blue}"
                   Width="{Binding GraphData[6].BarHeight, FallbackValue=25}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="8"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[7].Color, FallbackValue=Red}"
                   Width="{Binding GraphData[7].BarHeight, FallbackValue=25}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="9"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[8].Color, FallbackValue=Green}"
                   Width="{Binding GraphData[8].BarHeight, FallbackValue=10}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="10"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[9].Color, FallbackValue=Orange}"
                   Width="{Binding GraphData[9].BarHeight, FallbackValue=10}"/>

        <Rectangle Grid.Column="1" 
                   Grid.Row="11"
                   Style="{StaticResource GraphBar}"
                   Fill="{Binding GraphData[10].Color, FallbackValue=Pink}"
                   Width="{Binding GraphData[10].BarHeight, FallbackValue=10}"/>

        <!--Graph Landuse Labels-->
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[0].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[0].BarHeight, FallbackValue=25}"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[1].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[1].BarHeight, FallbackValue=25}"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="1"    
                   Grid.ColumnSpan="2"               
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[2].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[2].BarHeight, FallbackValue=25}"/>

        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[3].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[3].BarHeight, FallbackValue=10}"/>

        <TextBlock Grid.Row="5"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[4].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[4].BarHeight, FallbackValue=10}"/>

        <TextBlock Grid.Row="6"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[5].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[5].BarHeight, FallbackValue=25}"/>

        <TextBlock Grid.Row="7"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[6].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[6].BarHeight, FallbackValue=25}"/>

        <TextBlock Grid.Row="8"
                   Grid.Column="1"    
                   Grid.ColumnSpan="2"               
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[7].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[7].BarHeight, FallbackValue=25}"/>

        <TextBlock Grid.Row="9"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[8].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[8].BarHeight, FallbackValue=10}"/>

        <TextBlock Grid.Row="10"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[9].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[9].BarHeight, FallbackValue=10}"/>

        <TextBlock Grid.Row="11"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource GraphLandUseLabel}"
                   Text="{Binding GraphData[10].Name, FallbackValue=LandUse}"
                   Padding="{Binding GraphData[10].BarHeight, FallbackValue=10}"/>

        <!--Graph Landuse Areas-->
        <TextBlock Grid.Row="1"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[0].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="2"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[1].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="3"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[2].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="4"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[3].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="5"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[4].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="6"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[5].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="7"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[6].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="8"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[7].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="9"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[8].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="10"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[9].Area, FallbackValue=123}"/>

        <TextBlock Grid.Row="11"
                   Style="{StaticResource GraphLandUseArea}"
                   Text="{Binding GraphData[10].Area, FallbackValue=123}"/>

        <!--Graph Axis-->
        <Line Grid.Row="1"
            Grid.RowSpan="11"
            HorizontalAlignment="Right"
            Y1="0"
            Y2="1000"
            StrokeThickness="1"
            Stroke="Gray"/>

        <Line Grid.Row="12"
            Grid.Column="1"
            Grid.ColumnSpan="1"
            VerticalAlignment="Top"
            X1="0"
            X2="1000"
            StrokeThickness="1"
            Stroke="Gray"/>

    </Grid>
</UserControl>
