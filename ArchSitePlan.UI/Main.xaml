<UserControl x:Class="ArchSitePlan.UI.Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArchSitePlan.UI"
             xmlns:uc="clr-namespace:ArchSitePlan.UI.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="250"
             d:DataContext="{d:DesignInstance local:MainViewModel, IsDesignTimeCreatable=True}"
             Background="White">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Image x:Key="Cursor" 
                   Source="Resources\Cursor.png"
                   Height="20"
                   Width="20"/>

            <Image x:Key="Pline" 
                   Source="Resources\Pline.png"
                   Height="20"
                   Width="20"/> 

            <Image x:Key="Line" 
                   Source="Resources\Line.png"
                   Height="20"
                   Width="20"/>

        </ResourceDictionary>
        
    </UserControl.Resources>
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="35"/>
            <ColumnDefinition Width="35"/>
            <ColumnDefinition Width="35"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Parametric Site Capacity"
                   FontSize="20"
                   VerticalAlignment="Stretch"
                   TextAlignment="Center"
                   Grid.ColumnSpan="4"
                   Background="{StaticResource MainBlue}"
                   Foreground="White"/>
        
        <uc:Heading HeadingText="Road"
                    Grid.Row="1"
                    Grid.ColumnSpan="4"/>

        <TextBlock Text="Create/ Edit Existing"
                   Grid.Row="2"
                   VerticalAlignment="Center"/>

        <ToggleButton Grid.Row="2"
                      Grid.Column="3"
                      Content="{StaticResource Cursor}"
                      Style="{StaticResource SquareToggleButton}"
                      IsChecked="{Binding RoadCLSelectionModeActive}"/>

        <TextBlock Text="Road Width"
           Grid.Row="3"
           VerticalAlignment="Center"/>

        <TextBlock Text="{Binding RoadWidth, Mode=TwoWay}"
                 Grid.Row="4"
                 Grid.Column="3"
                 Grid.ColumnSpan="2"
                 VerticalAlignment="Center"/>

        <Slider Grid.Row="4"
                Grid.ColumnSpan="3"
                VerticalAlignment="Center"
                Margin="25,0,25,0"
                Minimum="1"
                Maximum="25"
                Value="{Binding RoadWidth, UpdateSourceTrigger=PropertyChanged}"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                TickPlacement="BottomRight"
                IsMoveToPointEnabled="True"
                />

        <Button Content="Visualize"
            Grid.Row="5"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Width="Auto"
                Style="{StaticResource SquareButton}"
                Command="{Binding VisualizeModel_Cmd}"/>

        <TextBlock Text="Parcel Edit"
                   Grid.Row="6"
                   VerticalAlignment="Center"/>

        <ToggleButton Grid.Row="7"
              Grid.Column="3"
              Content="{StaticResource Cursor}"
              Style="{StaticResource SquareToggleButton}"
              IsChecked="{Binding ParcelSelectionModeActive}"/>
        
    </Grid>
</UserControl>
