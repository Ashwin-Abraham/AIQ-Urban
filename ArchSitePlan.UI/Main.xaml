<UserControl x:Class="ArchSitePlan.UI.Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArchSitePlan.UI"
             xmlns:uc="clr-namespace:ArchSitePlan.UI.UserControls"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="250"
             d:DataContext="{d:DesignInstance local:MainViewModel, IsDesignTimeCreatable=True}"
             Background="White">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Styles.xaml" />
                <!-- MahApps.Metro resource dictionaries. Make sure that all file names are Case Sensitive! -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <!-- Theme setting -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Image x:Key="Cursor" 
                   Source="Resources\Cursor.png"
                   Height="20"
                   Width="20"/>

            <Image x:Key="Pline" 
                   Source="Resources\Pline.png"
                   Height="20"
                   Width="20"/> 

            <Image x:Key="Line" 
                   Source="Resources\Line.png"
                   Height="20"
                   Width="20"/>

        </ResourceDictionary>
        
    </UserControl.Resources>
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Parametric Site Capacity"
                   FontSize="20"
                   VerticalAlignment="Stretch"
                   TextAlignment="Center"
                   Grid.ColumnSpan="4"
                   Background="{StaticResource MainBlue}"
                   Foreground="White"/>
        
        <uc:Heading HeadingText="Road"
                    Grid.Row="1"
                    Grid.ColumnSpan="4"/>

        <TextBlock Text="Create/ Edit Existing"
                   Grid.Row="2"
                   VerticalAlignment="Center"/>

        <mah:ToggleSwitch Grid.Row="2"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          IsOn="{Binding RoadCLSelectionModeActive, Mode=TwoWay}"/>

        <TextBlock Text="Road Width"
           Grid.Row="3"
           VerticalAlignment="Center"/>

        <TextBlock Text="{Binding RoadWidth, Mode=TwoWay}"
                 Grid.Row="4"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

        <Slider Grid.Row="4"
                Grid.ColumnSpan="1"
                VerticalAlignment="Center"
                Margin="25,0,25,0"
                Minimum="1"
                Maximum="25"
                Value="{Binding RoadWidth, UpdateSourceTrigger=PropertyChanged}"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                TickPlacement="BottomRight"
                IsMoveToPointEnabled="True"
                />

        <Button Content="Visualize"
            Grid.Row="5"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Width="Auto"
                Style="{StaticResource SquareButton}"
                Command="{Binding VisualizeModel_Cmd}"/>

        <TextBlock Text="Parcel Edit"
                   Grid.Row="6"
                   VerticalAlignment="Center"/>

        <mah:ToggleSwitch Grid.Row="6"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          IsOn="{Binding ParcelSelectionModeActive, Mode=TwoWay}"/>

        <TextBlock  Grid.Row="7"
                    Background="{Binding SelectedLandUseColour}"
                    Grid.Column="1"
                    Width="43"
                    Margin="0,4,0,4"
                    HorizontalAlignment="Left"
                         />

        <ComboBox Grid.Row="7"
                  Margin="5"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding LandUses}"
                  SelectedItem="{Binding SelectedLandUse}"
                  />
    </Grid>
</UserControl>
