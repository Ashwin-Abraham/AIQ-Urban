<UserControl x:Class="ArchSitePlan.UI.Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArchSitePlan.UI"
             xmlns:uc="clr-namespace:ArchSitePlan.UI.UserControls"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="350"
             d:DataContext="{d:DesignInstance local:MainViewModel}"
             Background="White"
             Height="700"
             VerticalAlignment="Top"
             >
    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Styles.xaml" />
                <!-- MahApps.Metro resource dictionaries. Make sure that all file names are Case Sensitive! -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <!-- Theme setting -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Image x:Key="Cursor" 
                   Source="Resources\Cursor.png"
                   Height="20"
                   Width="20"/>

            <Image x:Key="Pline" 
                   Source="Resources\Pline.png"
                   Height="20"
                   Width="20"/>

            <Image x:Key="Line" 
                   Source="Resources\Line.png"
                   Height="20"
                   Width="20"/>

            <Image x:Key="Question" 
                   Source="Resources\Question.png"
                   Height="20"
                   Width="20"/>
        </ResourceDictionary>

    </UserControl.Resources>

    <StackPanel>

        <Grid Background="{StaticResource MainBlue}"
              Grid.ColumnSpan="2"
              Height="60">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>


            <Image  Source="Resources\LOGO.png"
                    Margin="9"
                    Grid.RowSpan="2"/>
            
            <TextBlock Text="AIQ Urban"
               Grid.Column="1"
               FontSize="25"
               TextAlignment="Left"
               VerticalAlignment="Center"
               Margin="14,0,0,0"
               Foreground="White"/>

            <mah:ToggleSwitch Grid.Row="1"
                        Grid.Column="1"
                        HorizontalContentAlignment="Center"
                        Margin="10,0,0,0"
                        OnCommand="{Binding ToggleEnableApp_Cmd}"
                        OffCommand="{Binding ToggleEnableApp_Cmd}"
                              OffContent="Disabled"
                              OnContent="Enabled"/>

        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      Height="600">
            <Grid Margin="5"
              IsEnabled="{Binding AppEnabled, Mode=TwoWay}">
            
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        

        <!--Road Expander-->
        <Expander Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Header="1. Roads"
                  IsExpanded="{Binding RoadExpanderOpen, Mode=TwoWay}"
                  >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="125"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding Source={StaticResource Question}, Path=Source}"
                       Height="20"
                       ToolTip="Road creator.
                       &#x0a;Select curves that will act as centerlines of roads.Set the width using the slider. 
                       &#x0a;When you enclose a region parcels of developable land will appear. "/>

                <TextBlock Text="Width"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>

                <Slider Grid.Column="2"
                    VerticalAlignment="Center"
                        Margin="25,0,25,0"
                        Minimum="1"
                        Maximum="25"
                        Value="{Binding RoadWidth, UpdateSourceTrigger=PropertyChanged}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        IsMoveToPointEnabled="True"
                        />

                <TextBlock Text="{Binding RoadWidth, Mode=TwoWay}"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Button Content="Add / Edit Road"
                        Grid.Column="4"
                        Command="{Binding AddOrUpdateRoads_Cmd}"
                        ToolTip="{Binding RoadInstruction}"/>

            </Grid>

        </Expander>

        <!--Land Use Expander-->
        <Expander Grid.Row="2"
                  Grid.ColumnSpan="3"
                  Header="2. Land Use"
                  IsExpanded="{Binding LanduseExpanderOpen, Mode=TwoWay}">

                    <Grid Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox VerticalAlignment="Center"
                                  Grid.Column="1"
                          ItemsSource="{Binding LandUses}"
                          SelectedItem="{Binding SelectedLandUse}"
                          />

                        <TextBlock Background="{Binding SelectedLandUseColour, Mode=TwoWay}"
                           Grid.Column="2"
                           Width="25"
                           Height="25"
                           Margin="5"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                        <Button Content="Change Use"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Command="{Binding ChangeParcelUse_Cmd}"
                                ToolTip="{Binding ChangeLandUseInstruction}"/>

                        <Button Content="Add divider"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                VerticalAlignment="Center"
                                Command="{Binding AddParcelDivider_Cmd}"
                                ToolTip="{Binding AddDividerInstruction}"/>

                        <Image Source="{Binding Source={StaticResource Question}, Path=Source}"
                                Height="20"
                               Grid.Row="1"
                               HorizontalAlignment="Center"
                               ToolTip="Manipulate land use parcels. (These have already been created by roads and study areas)
                               &#x0a;Select a parcel and change its land use. You can also add parcel/road dividers here by selecting a curve.
                               &#x0a;New landuses and colours will be added in future plugin versions"/>
                        
                    </Grid>
                </Expander>


        <!--Buildings Expander-->
        <Expander Grid.Row="3"
          Grid.ColumnSpan="3"
          Header="3. Buildings"
                  IsExpanded="{Binding BuildingsExpanderOpen, Mode=TwoWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Floor Count"
                           Grid.Column="0"/>
                
                <Slider Grid.Column="1"
                        Value="{Binding ActiveBuildingFloorCount, Mode=TwoWay}"
                        Minimum="1"
                        Maximum="40"/>
                
                <TextBox Text="{Binding ActiveBuildingFloorCount}"
                           Grid.Column="2"
                         Width="50"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Floor Height"
                           Grid.Row="1"
                           Grid.Column="0"/>

                <Slider Grid.Column="1"
                        Grid.Row="1"
                        Minimum="1.00"
                        Maximum="10.00"
                        Value="{Binding ActiveBuildingFloorHeight, Mode=TwoWay}"/>

                <TextBox Text="{Binding ActiveBuildingFloorHeight}"
                         Grid.Row="1"
                         Grid.Column="2"
                         VerticalAlignment="Center"
                         Width="50"
                         TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Total Height"
                           Grid.Row="2"
                           VerticalAlignment="Center"/>
                
                <TextBlock Text="{Binding ActiveBuildingHeight}"
                           Grid.Row="2"
                           Grid.Column="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="4"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                            <Image Source="{Binding Source={StaticResource Question}, Path=Source}"
                                Height="20"
                               Grid.Row="1"
                                   Width="40"
                                   ToolTip="Building Creator/ Editor. 
                                    &#x0a;Adjust the sliders to modify building floor count and floor height.
                                    &#x0a;There are 2 creation modes - by footprint and by mass.
                                   &#x0a;By footprint requires you to select a closed planar curve and this will be extruded.
                                   &#x0a;By mass requires you to select a closed brep or mesh and this becomes the envelope with floors drawn in"/>
                    
                            <RadioButton Margin="5"
                                 IsChecked="{Binding BuildingFootprintSelectorModeActive}"
                                 Content="By Footprint"
                                ToolTip="Select a closed planar curve and this will extrude up a new building"/> 
                    
                    <RadioButton Margin="5"
                                 IsChecked="{Binding BuildingMassSelectorModeActive}"
                                 Content="By Envelope"
                                 ToolTip="Select a brep or mesh and this will create a new building"/>
                    
                    <Button Content="Add Building"
                            Command="{Binding UpdateBuilding_Cmd}"
                            Margin="5,0,15,0"
                            ToolTip="{Binding AddBuildingInstruction}"/>

                </StackPanel>

            </Grid>
        </Expander>

        <!--Study Area-->
        <Expander Grid.Row="4"
                  Grid.ColumnSpan="3"
                  Header="4. Study Area"
                  IsExpanded="{Binding StudyAreaExpanderOpen, Mode=TwoWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                        <Image Source="{Binding Source={StaticResource Question}, Path=Source}"
                                Height="20"
                               ToolTip="Study Area Creator. 
                               &#x0a;A study area is created by selecting a closed curve.
                               &#x0a;It is used to isolate a part of you project and view metrics for just that area.
                               &#x0a;You will get graphs and excel tables with data separated by study area."/>

                        <TextBox Text="{Binding ActiveStudyAreaName, Mode=TwoWay}"
                                 Grid.Column="1"/>
                <Button Content="Add Study Area"
                              Grid.Column="2"
                              Command="{Binding AddStudyArea_Cmd}"/>
            </Grid>
        </Expander>

        <!--Exports-->
        <Expander Grid.Row="5"
                  Grid.ColumnSpan="3"
                  Header="5. Excel Exports"
                  IsExpanded="{Binding ExportsExpanderOpen, Mode=TwoWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding Source={StaticResource Question}, Path=Source}"
                        Height="20"
                       Grid.Row="1"
                       ToolTip="Exports To Excel. 
                       &#x0a;An excel file is created pulling the data in this rhino file.
                       &#x0a;The default file location is next to the rhino file. Please update it if needed."/> 
                
                <Button Content="Export Excel"
                Command="{Binding ExportExcel_Cmd}"
                VerticalAlignment="Center"
                Grid.Row="1"
                        Grid.Column="1"
                Width="100"
                ToolTip="{Binding ExportExcelInstruction}"/>

                <TextBlock Text="{Binding ExcelPath, FallbackValue=Excel_Path}"
                           VerticalAlignment="Center"
                           Margin="5"
                           Background="LightSteelBlue"
                           TextWrapping="Wrap"
                           Grid.ColumnSpan="3"/>

                <Button Content="Set Export Location"
                        VerticalAlignment="Center"
                        Command="{Binding SetExcelPath_Cmd}"
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="150"
                        ToolTip="{Binding SetExcelPathInstruction}"/>

            </Grid>
        </Expander>

        <TextBlock Text="Showing Metrics for study - "
                   Grid.Row="6"
                   VerticalAlignment="Center"
                   Height="30"
                   Margin="0,15,0,0"/>
        
        <ComboBox Grid.Row="6"
                  Grid.Column="1"
                  ItemsSource="{Binding StudyAreasNames}"
                  SelectedItem="{Binding ActiveStudyAreaName}"
                  VerticalAlignment="Center"
                  />
        
        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <uc:MetricBox MetricName="Total Bounded Area"
                          Value="{Binding ActiveStudy.Metrics.BoundedArea_Display }"
                          Unit="sq m"/>
            
            <uc:MetricBox MetricName="Developable Area"
                          Value="{Binding ActiveStudy.Metrics.DevelopableArea_Display }"
                          Unit="sq m"/>
            
            <uc:MetricBox MetricName="Built Area"
                          Value="{Binding ActiveStudy.Metrics.BuiltArea_Display }"
                          Unit="sq m"/>

            <uc:MetricBox MetricName="FAR"                                                    
                          Value="{Binding ActiveStudy.Metrics.FAR_Display }"
                          />
        </StackPanel>

            <lvc:CartesianChart 
            Grid.Row="9"
            Grid.ColumnSpan="2"
            Series="{Binding ParcelSeriesCollection}"
            DisableAnimations="True"
            FontSize="10"/>

            <mah:ToggleSwitch Grid.Row="10"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    OnContent="Built Up Area"
                    OffContent="Land Area"
                    IsOn="{Binding BuiltOrLandArea, Mode=TwoWay}"/>

            <TextBlock Text="Road Length"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Width="50"
                Grid.Row="11"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>

            <lvc:PieChart 
            Margin="5"
            Grid.Row="11"
            Grid.Column="0"
            Series="{Binding RoadLengthSeries}"
            FontSize="10"
            InnerRadius="60"
            HorizontalAlignment="Center"
            DisableAnimations="True"
            />

        <TextBlock Text="Road Area"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Width="50"
            Grid.Row="11"
            Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"/>

        <lvc:PieChart 
            DisableAnimations="True"
            HorizontalAlignment="Center"
            Margin="5"
            Grid.Row="11"
            Grid.Column="1"
            Series="{Binding RoadAreaSeries}"
            FontSize="10"
            InnerRadius="60"/>

        </Grid>
        </ScrollViewer>

        <Grid Background="{StaticResource MainBlue}"
              Height="35">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Found a bug? Want a new feature?"
                       TextWrapping="Wrap"
                       Foreground="White"
                       FontSize="12"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"/>

            <Button Content="Contact"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding ContactMe_Cmd}"
                    />

        </Grid>
    </StackPanel>

</UserControl>
