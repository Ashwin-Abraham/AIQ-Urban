<UserControl x:Class="ArchSitePlan.UI.Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArchSitePlan.UI"
             xmlns:uc="clr-namespace:ArchSitePlan.UI.UserControls"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="250"
             d:DataContext="{d:DesignInstance local:MainViewModel}"
             Background="White">
    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Styles.xaml" />
                <!-- MahApps.Metro resource dictionaries. Make sure that all file names are Case Sensitive! -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <!-- Theme setting -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Image x:Key="Cursor" 
                   Source="Resources\Cursor.png"
                   Height="20"
                   Width="20"/>

            <Image x:Key="Pline" 
                   Source="Resources\Pline.png"
                   Height="20"
                   Width="20"/>

            <Image x:Key="Line" 
                   Source="Resources\Line.png"
                   Height="20"
                   Width="20"/>
        </ResourceDictionary>

    </UserControl.Resources>

    <StackPanel>

        <Grid Background="{StaticResource MainBlue}"
              Grid.ColumnSpan="2"
              Height="60">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>


            <Image  Source="Resources\LOGO.png"
                    Margin="9"
                    Grid.RowSpan="2"/>
            
            <TextBlock Text="AIQ Urban"
               Grid.Column="2"
               FontSize="25"
               TextAlignment="Left"
               VerticalAlignment="Center"
               Margin="14,0,0,0"
               Foreground="White"/>

            <mah:ToggleSwitch Grid.Row="1"
                        Grid.Column="2"
                        HorizontalContentAlignment="Center"
                        Margin="10,0,0,0"
                        OnCommand="{Binding ToggleEnableApp_Cmd}"
                        OffCommand="{Binding ToggleEnableApp_Cmd}"
                              OffContent="Disabled"
                              OnContent="Enabled"/>
        </Grid>
        
        <Grid Margin="5"
              IsEnabled="{Binding AppEnabled, Mode=TwoWay}">
            
        <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        

        <!--Road Width Expander-->
        <Expander Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Header="1. Roads"
                  IsExpanded="{Binding RoadExpanderOpen, Mode=TwoWay}"
                  >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Width"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Slider Grid.Column="1"
                    VerticalAlignment="Center"
                        Margin="25,0,25,0"
                        Minimum="1"
                        Maximum="25"
                        Value="{Binding RoadWidth, UpdateSourceTrigger=PropertyChanged}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        IsMoveToPointEnabled="True"
                        />

                <TextBlock Text="{Binding RoadWidth, Mode=TwoWay}"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Button Content="Add/Update"
                        Grid.Column="3"
                        Command="{Binding AddOrUpdateRoads_Cmd}"/>

            </Grid>

        </Expander>

        <!--Land Use Expander-->
        <Expander Grid.Row="2"
                  Grid.ColumnSpan="3"
                  Header="2. Land Use"
                  IsExpanded="{Binding LanduseExpanderOpen, Mode=TwoWay}">

            <Grid Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <ComboBox VerticalAlignment="Center"
                          ItemsSource="{Binding LandUses}"
                          SelectedItem="{Binding SelectedLandUse}"
                          />

                <TextBlock Background="{Binding SelectedLandUseColour, Mode=TwoWay}"
                           Grid.Column="1"
                           Width="25"
                           Height="25"
                           Margin="5"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                <Button Content="Change Use"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding ChangeParcelUse_Cmd}"/>

                <TextBlock Text="Active parcel metrics"
                           Grid.Row="1"/>

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <uc:MetricBox MetricName="Parcel Area"
                                   Value="{Binding ActiveParcelMetrics.TotalArea }"
                                   Unit="sq m"/>

                    <uc:MetricBox MetricName="Built Area"
                   Value="{Binding ActiveParcelMetrics.BUA }"
                   Unit="sq m"/>

                    <uc:MetricBox MetricName="Ground Coverage"
                   Value="{Binding ActiveParcelMetrics.CoveragePctg }"
                   Unit="%"/>

                    <uc:MetricBox MetricName="FAR"                                                    
                   Value="{Binding ActiveParcelMetrics.FAR }"
                   />
                </StackPanel>


            </Grid>
        </Expander>


        <!--Buildings Expander-->
        <Expander Grid.Row="3"
          Grid.ColumnSpan="3"
          Header="3. Buildings"
                  IsExpanded="{Binding BuildingsExpanderOpen, Mode=TwoWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Floor Count"
                           Grid.Column="0"/>
                
                <Slider Grid.Column="1"
                        Value="{Binding ActiveBuildingFloorCount, Mode=TwoWay}"
                        Minimum="1"
                        Maximum="100"/>
                
                <TextBox Text="{Binding ActiveBuildingFloorCount}"
                           Grid.Column="2"
                         Width="50"
                         VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Floor Height"
                           Grid.Row="1"
                           Grid.Column="0"/>

                <Slider Grid.Column="1"
                        Grid.Row="1"
                        Minimum="1.50"
                        Maximum="20.00"
                        Value="{Binding ActiveBuildingFloorHeight, Mode=TwoWay}"/>

                <TextBox Text="{Binding ActiveBuildingFloorHeight}"
                         Grid.Row="1"
                         Grid.Column="2"
                         VerticalAlignment="Center"
                         Width="50"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Total Height"
                           Grid.Row="2"/>
                
                <TextBlock Text="{Binding TotalHeight}"
                           Grid.Row="2"
                           Grid.Column="2"/>

                <StackPanel Grid.Row="4"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <RadioButton Margin="5"
                                 IsChecked="{Binding BuildingFootprintSelectorModeActive}"
                                 Content="Footprint"/> 
                    
                    <RadioButton Margin="5"
                                 IsChecked="{Binding BuildingMassSelectorModeActive}"
                                 Content="Mass"/>
                    <Button Content="Update Building"
                            Command="{Binding UpdateBuilding_Cmd}"
                            Margin="5,0,15,0"/>

                </StackPanel>

            </Grid>
        </Expander>

        <!--Study Area-->
        <Expander Grid.Row="4"
                  Grid.ColumnSpan="3"
                  Header="4. Study Area"
                  IsExpanded="{Binding StudyAreaExpanderOpen, Mode=TwoWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding ActiveStudyAreaName, Mode=TwoWay}"/>
                <Button Content="Add Study Area"
                              Grid.Column="1"
                              Command="{Binding AddStudyArea_Cmd}"/>
            </Grid>
        </Expander>

        <!--Exports-->
        <Expander Grid.Row="5"
                  Grid.ColumnSpan="3"
                  Header="5. Exports"
                  IsExpanded="{Binding ExportsExpanderOpen, Mode=TwoWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Button Content="Excel"
                        Command="{Binding ExportExcel_Cmd}"
                        VerticalAlignment="Center"/>

                <TextBlock Text="{Binding ExcelPath, FallbackValue=Excel_Path}"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="5"
                           Background="LightSteelBlue"
                           TextWrapping="Wrap"/>

                <Button Content="Path"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding SetExcelPath_Cmd}"/>

            </Grid>
        </Expander>
        
        <!--Active Study Area-->
        <!--<Grid Grid.Row="6"
              Grid.ColumnSpan="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>-->

        <TextBlock Text="Study Area Name"
                   Grid.Row="6"/>
        
        <ComboBox Grid.Row="6"
                  Grid.Column="1"
                  ItemsSource="{Binding StudyAreasNames}"
                  SelectedItem="{Binding ActiveStudyAreaName}"
                  />
        
        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <uc:MetricBox MetricName="Total Bounded Area"
                          Value="{Binding ActiveStudy.Metrics.BoundedArea_Display }"
                          Unit="sq m"/>
            
            <uc:MetricBox MetricName="Developable Area"
                          Value="{Binding ActiveStudy.Metrics.DevelopableArea_Display }"
                          Unit="sq m"/>
            
            <uc:MetricBox MetricName="Built Area"
                          Value="{Binding ActiveStudy.Metrics.BuiltArea_Display }"
                          Unit="sq m"/>

            <uc:MetricBox MetricName="FAR"                                                    
                          Value="{Binding ActiveStudy.Metrics.FAR_Display }"
                          />
        </StackPanel>

            <lvc:CartesianChart 
            Grid.Row="9"
            Grid.ColumnSpan="2"
            Series="{Binding ParcelSeriesCollection}"
            DisableAnimations="True"
            FontSize="10"/>



            <mah:ToggleSwitch Grid.Row="10"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    OnContent="Built Up Area"
                    OffContent="Land Area"
                    IsOn="{Binding BuiltOrLandArea, Mode=TwoWay}"/>

            <TextBlock Text="Road Length"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Width="50"
                Grid.Row="11"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>

            <lvc:PieChart 
            Margin="5"
            Grid.Row="11"
            Grid.Column="0"
            Series="{Binding RoadLengthSeries}"
            FontSize="10"
            InnerRadius="40"
            HorizontalAlignment="Stretch"
            DisableAnimations="True"
            />

        <TextBlock Text="Road Area"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Width="50"
            Grid.Row="11"
            Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"/>

        <lvc:PieChart 
            DisableAnimations="True"
            HorizontalAlignment="Stretch"
            Margin="5"
            Grid.Row="11"
            Grid.Column="1"
            Series="{Binding RoadAreaSeries}"
            FontSize="10"
            InnerRadius="40"/>


        <!--<uc:HorizontalGraph Grid.Row="8"
                            Grid.ColumnSpan="2"
                            GraphData="{Binding LandUseGraphData, UpdateSourceTrigger=Default, Mode=OneWay}"
                            GraphTitle="Landuse Area"
                            />-->

        <!--<Button Content="Test"
                Grid.Row="9"
                Command="{Binding Test_Cmd}"/>-->
    </Grid>
    </StackPanel>

</UserControl>
