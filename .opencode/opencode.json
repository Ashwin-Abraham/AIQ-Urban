{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": true,
  "permission": {
    "external_directory": "allow"
  },
  "enabled_providers": ["opencode", "google"],
  "disabled_providers": [],
  "provider": {
    "google": {
      "models": {
        "gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
