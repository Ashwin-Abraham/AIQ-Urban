<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0</TargetFrameworks>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<TargetExt>.rhp</TargetExt>
		<NoWarn>NU1701</NoWarn>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

	</PropertyGroup>
  
  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>1.0</Version>
    <Title>AIQ.Urban.RhinoPlugin</Title>
    <Company>AIQ.Urban.RhinoPlugin Authors</Company>
    <Description>Description of AIQ.Urban.RhinoPlugin</Description>
	  <LangVersion>12</LangVersion>
	  <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.32.26131.18001-rc" ExcludeAssets="runtime" />
    <PackageReference Include="WebSocketSharp" Version="1.0.3-rc11" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="..\UI\aiq-urban-ui\dist\**\*">
      <Link>HTML_UI\wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>HTML_UI\wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <Target Name="EnsureVueUiDistExists" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\UI\aiq-urban-ui\dist\index.html')" Text="AIQ Urban UI not found." />
  </Target>
  
  <ItemGroup>
    <ProjectReference Include="..\AIQ.Urban.RhinoInterface\AIQ.Urban.RhinoInterface.csproj" />
  </ItemGroup>
  
</Project>
